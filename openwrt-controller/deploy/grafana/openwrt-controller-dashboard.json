      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "id": 8,
      "targets": [
        { "expr": "rate(openwrt_ssh_attempts_total[2m])", "legendFormat": "SSH Attempts/sec", "refId": "A" },
        { "expr": "rate(openwrt_ssh_successes_total[2m])", "legendFormat": "SSH Success/sec", "refId": "B" },
        { "expr": "rate(openwrt_ssh_failures_total[2m])", "legendFormat": "SSH Failures/sec", "refId": "C" }
      ],
      "title": "OpenWrt SSH Operations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "id": 9,
      "targets": [
        { "expr": "rate(openwrt_ubus_calls_total[2m])", "legendFormat": "ubus Calls/sec", "refId": "A" },
        { "expr": "rate(openwrt_ubus_failures_total[2m])", "legendFormat": "ubus Failures/sec", "refId": "B" },
        { "expr": "rate(openwrt_nftables_operations_total[2m])", "legendFormat": "nftables Ops/sec", "refId": "C" },
        { "expr": "rate(openwrt_nftables_failures_total[2m])", "legendFormat": "nftables Failures/sec", "refId": "D" }
      ],
      "title": "OpenWrt ubus & nftables Operations",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 103,
      "title": "Quota Enforcement & Reconciliation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 10,
      "targets": [
        { "expr": "quota_records_total", "legendFormat": "Total Quotas", "refId": "A" },
        { "expr": "quota_active_total", "legendFormat": "Active Quotas", "refId": "B" },
        { "expr": "quota_exhausted_total", "legendFormat": "Exhausted Quotas", "refId": "C" },
        { "expr": "quota_blocked_devices_total", "legendFormat": "Blocked Devices", "refId": "D" }
      ],
      "title": "Quota & Device Counts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 11,
      "targets": [
        { "expr": "rate(quota_enforcement_cycles_total[2m])", "legendFormat": "Enforcement Cycles/sec", "refId": "A" },
        { "expr": "rate(quota_enforcement_failures_total[2m])", "legendFormat": "Enforcement Failures/sec", "refId": "B" },
        { "expr": "rate(quota_reconciliation_cycles_total[2m])", "legendFormat": "Reconciliation Cycles/sec", "refId": "C" },
        { "expr": "rate(quota_reconciliation_failures_total[2m])", "legendFormat": "Reconciliation Failures/sec", "refId": "D" }
      ],
      "title": "Enforcement & Reconciliation Cycles",
      "type": "timeseries"
    }
