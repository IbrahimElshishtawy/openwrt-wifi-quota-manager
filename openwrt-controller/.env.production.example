# ==============================================================================
# OpenWrt Controller - Production Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# CORS Configuration
# IMPORTANT: Wildcard "*" is strictly prohibited in production.
# Provide comma-separated list of trusted origins (e.g. your management web UI or mobile domain)
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:5173

# API Authentication Token (MANDATORY IN PRODUCTION)
# Must be at least 16 characters long and cannot be a common dictionary word.
# Generate with: openssl rand -hex 24
API_AUTH_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN_AT_LEAST_16_CHARS

# Rate Limiting (Protects API against abuse and brute-force)
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# OpenWrt Router Connection
OPENWRT_HOST=192.168.50.1
OPENWRT_PORT=80
OPENWRT_USERNAME=root
# Provide either OPENWRT_PASSWORD or OPENWRT_SSH_KEY_PATH below
OPENWRT_PASSWORD=REPLACE_WITH_STRONG_ROUTER_PASSWORD
OPENWRT_USE_HTTPS=false

# OpenWrt Router SSH Parameters (Used for nlbwmon queries & nftables rule sync)
OPENWRT_SSH_PORT=22
OPENWRT_SSH_USER=root
# Path to dedicated SSH private key (Recommended over password authentication)
# OPENWRT_SSH_KEY_PATH=/etc/openwrt-controller/id_ed25519
OPENWRT_SSH_TIMEOUT_MS=5000

# Resilience & Fault Isolation
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=10000

# Persistent Storage Paths (Ensure directory has read/write permissions for service user)
QUOTA_STORAGE_PATH=data/quotas.json
FIREWALL_STORAGE_PATH=data/firewall-blocks.json

# Quota Enforcement Monitor
QUOTA_ENFORCEMENT_ENABLED=true
QUOTA_ENFORCEMENT_INTERVAL_MS=5000

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=5000
