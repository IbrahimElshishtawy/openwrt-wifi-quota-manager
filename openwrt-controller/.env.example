# ==============================================================================
# OpenWrt Controller - Development Environment Configuration Example
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS Configuration (Wildcard permitted only in development)
CORS_ORIGIN=*

# API Authentication (Optional in development, mandatory in production)
# API_AUTH_TOKEN=your-dev-token-min-16-characters

# Rate Limiting Configuration
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# OpenWrt Router HTTP / ubus Configuration
OPENWRT_HOST=192.168.50.1
OPENWRT_PORT=80
OPENWRT_USERNAME=root
OPENWRT_PASSWORD=
OPENWRT_USE_HTTPS=false

# OpenWrt Router SSH Configuration (For nlbwmon & nftables)
OPENWRT_SSH_PORT=22
OPENWRT_SSH_USER=root
# OPENWRT_SSH_KEY_PATH=/path/to/id_rsa
OPENWRT_SSH_TIMEOUT_MS=5000

# Resilience & Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=10000

# Quota & Storage Paths
QUOTA_STORAGE_PATH=data/quotas.json
FIREWALL_STORAGE_PATH=data/firewall-blocks.json

# Quota Enforcement Monitor Configuration
QUOTA_ENFORCEMENT_ENABLED=true
QUOTA_ENFORCEMENT_INTERVAL_MS=5000

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=5000
