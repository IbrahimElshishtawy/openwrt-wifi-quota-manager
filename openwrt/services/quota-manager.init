#!/bin/sh /etc/rc.common
# OpenWrt procd service script for Wi-Fi Quota Manager
# Location on router: /etc/init.d/quota-manager

USE_PROCD=1
START=95
STOP=10

APP_DIR="/root/openwrt-wifi-quota-manager/openwrt"
PYTHON="/usr/bin/python3"
RULES_NFT="$APP_DIR/nftables/rules.nft"

start_service() {
    logger -t quota-manager "Initializing Wi-Fi Quota Manager subsystem"

    # 1. Ensure nftables access control table and set are initialized
    if [ -f "$RULES_NFT" ]; then
        logger -t quota-manager "Loading nftables access control rules from $RULES_NFT"
        nft -f "$RULES_NFT" 2>/dev/null || true
    fi

    # 2. Register REST API daemon with procd supervisor
    if [ -f "$APP_DIR/api/api_usage.py" ]; then
        local api_key="$(uci -q get quota-manager.api.api_key || echo "$QUOTA_API_KEY")"
        local port="$(uci -q get quota-manager.api.port || echo "8080")"
        logger -t quota-manager "Starting persistent REST API daemon on port $port"
        procd_open_instance api
        procd_set_param command "$PYTHON" "$APP_DIR/api/api_usage.py" --port "$port"
        if [ -n "$api_key" ]; then
            procd_set_param env QUOTA_API_KEY="$api_key"
        fi
        procd_set_param respawn 3600 5 0
        procd_set_param file "$APP_DIR/config/devices.json"
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi

    # 3. Perform initial quota evaluation
    logger -t quota-manager "Executing initial quota audit"
    "$PYTHON" "$APP_DIR/scripts/check_quota.py" >/dev/null 2>&1 || true
}

stop_service() {
    logger -t quota-manager "Stopping Wi-Fi Quota Manager service"
}

reload_service() {
    logger -t quota-manager "Reloading Wi-Fi Quota Manager configuration and auditing quotas"
    "$PYTHON" "$APP_DIR/scripts/check_quota.py"
}
