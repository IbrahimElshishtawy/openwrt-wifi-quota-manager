#!/bin/sh /etc/rc.common
# OpenWrt procd service script for Wi-Fi Quota Manager
# Location on router: /etc/init.d/quota-manager

USE_PROCD=1
START=95
STOP=10

APP_DIR="/root/openwrt-wifi-quota-manager/openwrt"
PYTHON="/usr/bin/python3"
RULES_NFT="$APP_DIR/nftables/rules.nft"

start_service() {
    # 1. Ensure nftables access control table is initialized
    if [ -f "$RULES_NFT" ]; then
        nft -f "$RULES_NFT" 2>/dev/null || true
    fi

    # 2. Register quota management service with procd supervisor
    procd_open_instance quota_manager
    procd_set_param command "$PYTHON" "$APP_DIR/scripts/check_quota.py"
    procd_set_param file "$APP_DIR/config/devices.json"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    logger -t quota-manager "Stopping Wi-Fi Quota Manager service"
}

reload_service() {
    logger -t quota-manager "Reloading Wi-Fi Quota Manager configuration"
    "$PYTHON" "$APP_DIR/scripts/check_quota.py"
}
